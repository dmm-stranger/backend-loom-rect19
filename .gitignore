.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Build output
dist/
build/
coverage/

# Local image uploads — never commit to git
uploads/

# OS / Editor
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea
*.swp
